    ON o.CustomerID = c.CustomerID
JOIN OrderItem oi
    ON o.OrderID = oi.OrderID
JOIN Product p
    ON oi.ProductID = p.ProductID
JOIN Category cat
    ON p.CategoryID = cat.CategoryID
JOIN Payment pay
    ON o.OrderID = pay.OrderID
