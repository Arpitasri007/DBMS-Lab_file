-- =====================================================
-- JOIN QUERY
-- =====================================================

SELECT
    o.OrderID,
    c.CustomerName,
    p.ProductName,
    oi.Quantity,
    oi.UnitPrice
FROM Orders o
JOIN Customer c
    ON o.CustomerID = c.CustomerID
JOIN OrderItem oi
    ON o.OrderID = oi.OrderID
JOIN Product p
    ON oi.ProductID = p.ProductID;


